# backend/.env.example
# Copy this file to .env and fill in your actual values.

# --- Server ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- AI Provider (Groq) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model overrides. Both fall back to a built-in candidate list if unset or
# if the named model has been decommissioned, so only set these to pin a model.
# Text (architecture generation + report narratives) - default: qwen/qwen3.8-27b
GROQ_MODEL=
# Vision (diagram image import) - default: qwen/qwen3.8-27b
# Must be a vision-capable model; check with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_VISION_MODEL=

# --- OAuth sign-in ---
# Google: the OAuth 2.0 Web client id from https://console.cloud.google.com/apis/credentials
# Must be the SAME value as the frontend's VITE_GOOGLE_CLIENT_ID - the backend
# checks the token's `aud` claim against it.
GOOGLE_CLIENT_ID=

# GitHub: create an OAuth app at https://github.com/settings/developers with
# callback URL <frontend-origin>/auth/github/callback. Sign-in returns 503 until
# both are set. The client id must match the frontend's VITE_GITHUB_CLIENT_ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Neon Postgres ---
DATABASE_URL=
DATABASE_SSL=true

# --- Webhooks ---
WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# --- GhostTrace ML Inference ---
INFERENCE_SERVER_URL=http://localhost:8001
